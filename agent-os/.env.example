# ─────────────────────────────────────────────────────────────
# Trade Sentinel — backend environment variables
# Copy this file to `.env` and fill in the values you need.
# Anything commented out uses a sensible default (see config.py).
# ─────────────────────────────────────────────────────────────


# ═════════════════════════════════════════════════════════════
# API keys — REQUIRED (secrets: never commit real values)
# ═════════════════════════════════════════════════════════════

# You.com Research API key. https://you.com/platform/api-keys
YDC_API_KEY=your_youcom_api_key_here

# LLM provider — set ONE of the two blocks below.

# Option 1: OpenAI
OPENAI_API_KEY=your_openai_api_key_here

# Option 2: Azure OpenAI (leave endpoint as the resource base URL —
# the code strips any trailing /openai or /openai/v1 automatically)
# Azure_API_KEY=your_azure_openai_key_here
# Azure_ENDPOINT=https://your-resource.openai.azure.com/
# Azure_API_VERSION=2024-10-21

# Optional — used only if you have a Gemini-backed toolkit wired in
# GOOGLE_API_KEY=

# Optional override for the You.com base URL. Each toolkit
# (contents / finance / research / search) falls back to its
# own vendor default when unset.
# YDC_BASE_URL=


# ═════════════════════════════════════════════════════════════
# Application server
# ═════════════════════════════════════════════════════════════

# FastAPI bind host + port
# HOST=0.0.0.0
# PORT=8000

# Uvicorn --reload (default: on in DEVELOPMENT, off in PRODUCTION)
# RELOAD=

# CORS — comma-separated allowed frontend origins
# CORS_ORIGINS=http://localhost:5173,http://localhost:3000,https://os.agno.com

# AgentOS display name
# AGENT_OS_NAME=Trade Sentinel OS

# FastAPI app title
# APP_TITLE=GTS Service

# Multi-tenant: set to the tenant id for this deployment. Leave unset
# for single-tenant.
# TENANT_ID=


# ═════════════════════════════════════════════════════════════
# LLM
# ═════════════════════════════════════════════════════════════

# Model / deployment id (default: gpt-4o-mini)
# MODEL_ID=gpt-4o-mini

# Allow the model to fire multiple tool calls in a single turn.
# Default OFF — sequential tool execution keeps us well under
# You.com's per-key rate limit and makes retries predictable.
# PARALLEL_TOOLS=0


# ═════════════════════════════════════════════════════════════
# Agent runtime
# ═════════════════════════════════════════════════════════════

# Cap each specialist to N research calls per run.
# AGENT_TOOL_CALL_LIMIT=3

# Whether Agno should thread conversation history / memory across runs.
# Off by default — materially affects cost.
# AGENT_ADD_HISTORY_TO_CONTEXT=0
# AGENT_UPDATE_MEMORY_ON_RUN=0

# Internal token that the scheduler executor presents when calling
# our own /gts/sweep/cron. Rotate for every deployment.
# GTS_INTERNAL_SERVICE_TOKEN=


# ═════════════════════════════════════════════════════════════
# Database
# ═════════════════════════════════════════════════════════════

# Full DB URL takes precedence when set (Azure SQL / Postgres):
#   DATABASE_URL=mssql+pyodbc://user:pass@server/db?driver=ODBC+Driver+18+for+SQL+Server
#   DATABASE_URL=postgresql://user:pass@host:5432/gts
# If unset, we fall back to a local SQLite file at DB_PATH.
# DATABASE_URL=

# SQLite path (used only when DATABASE_URL is unset).
# DB_PATH=data/gts.db

# Agno session/memory table names (kept configurable for
# multi-tenant deployments that partition Agno state).
# AGNO_SESSION_TABLE=sessions
# AGNO_MEMORY_TABLE=memories


# ═════════════════════════════════════════════════════════════
# Scheduler
# ═════════════════════════════════════════════════════════════

# Base URL the scheduler executor uses to reach our HTTP endpoints.
# Defaults to http://127.0.0.1:${PORT}. Override behind a reverse
# proxy or when running on a non-loopback network.
# SCHEDULER_BASE_URL=http://127.0.0.1:8000

# How often the poller checks for due schedules (seconds).
# SCHEDULER_POLL_INTERVAL_SECONDS=15

# Executor HTTP timeout for a single scheduled run (seconds).
# SCHEDULE_RUN_TIMEOUT=3600

# Timezone used to interpret PRESET_TO_CRON expressions.
# SCHEDULE_TIMEZONE=UTC

# Default preset when no schedule row exists yet.
#   manual | daily | weekly | monthly
# GTS_SCHEDULE=manual


# ═════════════════════════════════════════════════════════════
# You.com research policy
# ═════════════════════════════════════════════════════════════

# Depth of each research call. Options (cheapest → most expensive):
#   lite | standard | deep | exhaustive
# "exhaustive" burns the most You.com credits — use "standard" for dev/testing.
# YOUCOM_RESEARCH_EFFORT=exhaustive

# HTTP timeout for a single research call (seconds).
# YOUCOM_RESEARCH_TIMEOUT_SECONDS=500

# Max characters kept per returned source.
# YOUCOM_TEXT_LENGTH_LIMIT=1000

# Per-specialist freshness windows. Values: day | week | month | year
# SPECIALIST_FRESHNESS_SANCTIONS=month
# SPECIALIST_FRESHNESS_EXPORT_CONTROL=month
# SPECIALIST_FRESHNESS_REGULATORY=month
# SPECIALIST_FRESHNESS_CUSTOMS_TARIFF=month
# SPECIALIST_FRESHNESS_TRADE_AGREEMENT=month
# SPECIALIST_FRESHNESS_GEOPOLITICAL=week


# ═════════════════════════════════════════════════════════════
# Events API
# ═════════════════════════════════════════════════════════════

# Pagination for GET /gts/events
# EVENTS_LIST_DEFAULT_LIMIT=25
# EVENTS_LIST_MAX_LIMIT=100


# ═════════════════════════════════════════════════════════════
# Environment profile
# ═════════════════════════════════════════════════════════════
# DEVELOPMENT (default) → FastAPI route logs on, Agno per-agent
#                         banners on, SQL/HTTP quiet.
# PRODUCTION            → everything quiet except sentinel.* INFO.
# ENVIRONMENT=DEVELOPMENT


# ── Per-layer debug flags ────────────────────────────────────
# Each accepts 1/true/yes/on to enable, 0/false/no/off to disable.
# Leaving a flag unset falls back to the ENVIRONMENT default.
#
# DEVELOPMENT defaults:
#   SENTINEL_DEBUG=0    (our own sentinel.* logs at INFO)
#   AGNO_DEBUG=1        (Agno framework + agent banners visible)
#   FASTAPI_DEBUG=1     (uvicorn.access route logs visible)
#   SQL_DEBUG=0         (SQLAlchemy queries hidden)
#   HTTP_DEBUG=0        (httpx traffic hidden)
#
# PRODUCTION defaults: all of the above OFF.
#
# SENTINEL_DEBUG=0
# AGNO_DEBUG=
# FASTAPI_DEBUG=
# SQL_DEBUG=0
# HTTP_DEBUG=0
# DEBUG_ALL=0


# ── Log output ───────────────────────────────────────────────
# LOG_FORMAT   "text" (default, coloured console) or "json"
#              (one-line-per-log for Datadog / Loki / journald)
# LOG_FILE     file path for rotating handler.
#              Default: logs/sentinel.log
#              Set to "-" to disable file logging.
# LOG_MAX_MB   rotation size in MB (default 10)
# LOG_BACKUPS  how many rotated files to keep (default 5)
#
# LOG_FORMAT=text
# LOG_FILE=
# LOG_MAX_MB=10
# LOG_BACKUPS=5
